# Copy to .env and fill in. Never commit .env.
# Big model service (Kaggle notebook services/vlm/kaggle_vlm_service.ipynb prints both lines)
ENGRAM_VLM_URL=https://xxxx.trycloudflare.com
ENGRAM_VLM_TOKEN=paste-the-token-here
# Small model service (runs on this laptop)
ENGRAM_TRIGGER_URL=http://127.0.0.1:8001
ENGRAM_USE_TRIGGER=1
# Where the research code is (default: ../mnemo)
# MNEMO_PATH=/home/you/Documents/Engram/mnemo
# Live mode: the lag limit (seconds, never above 60) and the object-detection size of the small model
ENGRAM_MAX_LAG_S=45
ENGRAM_YOLO_IMGSZ=320
